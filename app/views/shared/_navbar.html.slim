header.bg-white
  nav.mx-auto.flex.max-w-7xl.items-center.justify-between.px-6.py-3.lg:px-8[ariel-label='Global']
    .flex.lg:flex-1
      = link_to '/', class: '-m-1.5 p-1.5' do
        span.sr-only Taggin
        span.font-bold.uppercase Taggin

    .flex.lg:hidden
      button type='button' class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-gray-700"
        span.sr-only Open main menu
        svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon"
          path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"

    .hidden.lg:flex.lg:gap-x-12
      .relative
        = link_to t('navbar.albums'), albums_path, class: 'text-sm font-semibold leading-6 text-gray-900 p-3'

    .hidden.lg:flex.lg:flex-1.lg:justify-end
      - if authenticated?
        = link_to Current.user.username, you_root_path, class: 'text-sm font-semibold leading-6 text-gray-400 p-3 italic'
        = button_to 'logout', session_path, method: :delete, class: 'text-sm font-semibold leading-6 text-gray-900 p-3'
      - else
        = link_to signup_path, class: 'text-sm font-semibold leading-6 text-gray-900 p-3' do
          = t('navbar.sign_up')
          span aria-hidden="true"

        = link_to new_session_path, class: 'bg-stone-200 text-sm font-semibold leading-6 text-gray-900 p-3' do
          = t('navbar.loggin')
          span aria-hidden="true"
