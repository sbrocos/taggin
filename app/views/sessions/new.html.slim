= simple_form_for :user, url: session_path, method: :post do |f|
  = render 'shared/error_messages', resource: @user

  .grid.grid-cols-2.bg-stone-700.text-white
    .fields.pt-5
    .fields.pt-5.p-10
      div
        h1.mb-12 Sessions#new
        = f.input :email_address, require: true, autofocus: true, autocomplete: 'email',
                  input_html: { class: 'w-full' },
                  label_html: { class: 'block mb-2' },
                  wrapper_html: { class: 'mb-5'}
        = f.input :password, require: true, autocomplete: 'new_password',
                  input_html: { class: 'w-full text-black' },
                  label_html: { class: 'block mb-2' }
      .border-t-1.border-white.mt-15.text-end
        = link_to 'reset password', new_password_path

      div
      .text-end.mt-10
        = f.submit 'log in', class: 'bg-stone-600 text-stone-100 p-2 hover:bg-stone-400 px-5 py-3 cursor-pointer'

